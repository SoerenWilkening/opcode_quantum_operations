
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Editor / IDE
.idea/

# CMake build trees
build*/
cmake-build-*/
compile_commands.json

# Python bytecode from shim/gen_shim.py and the two Step-22 suites. The ctest
# registration also sets PYTHONDONTWRITEBYTECODE=1; this catches a bare run.
__pycache__/
*.pyc

# tools/qtg — the arXiv:2310.06623 Quantum Tree Generator demo. Untracked for
# now: it drives libcqops' INTERNAL surface (kernels, M06, M22) rather than the
# frozen cqrt_* ABI, it is registered in no CMake file, and it is named in
# none of the three planning docs. Track it when it gets a bead and a home.
tools/qtg/
